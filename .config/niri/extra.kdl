// Niri Config (based on sensei/nixos laptop config)
input {
    trackpoint {
        accel-speed 0.25
        accel-profile "adaptive"
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    background-color "transparent"
    gaps 12
    focus-ring {
        width 1.5
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }
    shadow {
        on
        draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    WAYLAND_DISPLAY "wayland-1"
}

spawn-at-startup "noctalia-shell"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

workspace "1" { }
workspace "2" { }
workspace "3" { }

/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

binds {
    Mod+Shift+T hotkey-overlay-title="Open a Terminal: wezterm" { spawn "wezterm"; }

    // Noctalia controls
    Mod+Return{ spawn-sh "noctalia-shell ipc call launcher toggle"; }
    Mod+Shift+L hotkey-overlay-title="Lock the Screen: noctalia-shell lock" { spawn-sh "noctalia-shell ipc call lockScreen lock"; }
    Mod+Space { spawn-sh "noctalia-shell ipc call settings toggle"; }
    Mod+Shift+Space { spawn-sh "noctalia-shell ipc call controlCenter toggle"; }
    Mod+Shift+M { spawn-sh "noctalia-shell ipc call plugin togglePanel mediaMini"; }

    // Noctalia Media Controls
    Ctrl+Alt+Space { spawn-sh "noctalia-shell ipc call media playPause"; }
    Ctrl+Alt+Left { spawn-sh "noctalia-shell ipc call media previous"; }
    Ctrl+Alt+Right { spawn-sh "noctalia-shell ipc call media next"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia-shell ipc call brightness increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia-shell ipc call brightness decrease"; }
    // Switches focus between the current and the previous workspace.
    Mod+Tab { focus-workspace-previous; }
}

cursor {
    xcursor-theme "BreezeX-RosePine-Linux"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 10000
}

layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-wallpaper-eDP-1"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

gestures {
    hot-corners {
        off
    }
}

// Terminal blur effect
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$|^Alacritty$|^kitty$|^com\.mitchellh\.ghostty$"#
    opacity 0.95
    background-effect {
        blur true
        noise 0.05
    }
}
